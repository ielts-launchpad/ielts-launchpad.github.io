---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { en } from '@/i18n/en';

const page = en.pages.about;
---

<BaseLayout title={page.title} description={page.description}>
  <h1 class="text-2xl font-bold">{page.heading}</h1>
  <p class="mt-4 text-slate-700">{page.intro}</p>
  <p class="mt-4 text-slate-600">{page.aiContentNotice}</p>
  <p class="mt-2 text-slate-600">{page.aiAudioNotice}</p>
</BaseLayout>
