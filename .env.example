# Public environment variables (exposed to the browser). Copy to `.env` and fill in.
# Never put secrets here — Worker secrets live in Cloudflare (see worker/README.md).

# Base URL of the Cloudflare Worker that proxies AI requests.
PUBLIC_WORKER_URL=

# Cloudflare Turnstile site key shown on AI forms.
# In dev/tests use the documented Turnstile test key (always passes):
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
